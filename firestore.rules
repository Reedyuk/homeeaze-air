rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist signups: write-only from the client
    match /waitlist/{docId} {
      allow create: if request.resource.data.keys().hasAll(['email', 'timestamp'])
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3;
      allow read, update, delete: if false;
    }

    // Analytics events: write-only from the client
    match /events/{docId} {
      allow create: if request.resource.data.keys().hasAll(['type', 'timestamp']);
      allow read, update, delete: if false;
    }
  }
}
